NEBIUS_API_KEY=
NEBIUS_MODEL_ID=moonshotai/Kimi-K3
NEBIUS_API_BASE=https://api.tokenfactory.us-north1.nebius.com/v1/
NEBIUS_KIMI_API_BASE=https://api.tokenfactory.eu-west2.nebius.com/v1/
NEBIUS_MAX_TOKENS=4096
NEBIUS_REQUEST_TIMEOUT=120
NEBIUS_REASONING_EFFORT=none
# Set after preparing a CrossWordBench dataset:
# CROSSWORD_DATASET_PATH=data/crosswordbench/demo-7x7.json
MAX_DAILY_RUNS=10
WORDFREQ_LIMIT=100000
LOG_LEVEL=INFO
LOG_FILE=logs/crossword-agent.jsonl
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
TRACE_ENABLED=true
TRACE_FILE=logs/crossword-agent-traces.jsonl
TRACE_MAX_BYTES=10000000
TRACE_BACKUP_COUNT=5
OTEL_SERVICE_NAME=crossword-agent
