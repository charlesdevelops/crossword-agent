AWS_REGION=ap-southeast-2
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BEARER_TOKEN_BEDROCK=
LLM_PROVIDER=bedrock
BEDROCK_REGION=ap-southeast-2
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5
# Set after preparing a grid dataset, for example:
# CROSSWORD_DATASET_PATH=data/madbonze/train.json
# Optional human clue-answer BM25 index built from CrosswordQA train.csv:
# CROSSWORD_CLUE_INDEX_PATH=data/crosswordqa/train-clue-index.json
MAX_DAILY_RUNS=10
WORDFREQ_LIMIT=100000
LOG_LEVEL=INFO
LOG_FILE=logs/crossword-agent.jsonl
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
TRACE_ENABLED=true
TRACE_FILE=logs/crossword-agent-traces.jsonl
TRACE_MAX_BYTES=10000000
TRACE_BACKUP_COUNT=5
OTEL_SERVICE_NAME=crossword-agent
# Optional model-specific pricing for evaluation reports:
# INPUT_COST_PER_MTOK=3
# OUTPUT_COST_PER_MTOK=15

# Final Nebius phase:
# LLM_PROVIDER=nebius
# NEBIUS_API_KEY=
# NEBIUS_MODEL_ID=Qwen/Qwen3-235B-A22B
